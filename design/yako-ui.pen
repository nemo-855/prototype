                      "textGrowth": "auto",
                      "fontFamily": "$font.serif",
                      "fontSize": "$font.display",
                      "fontWeight": "700",
                      "fill": "$color.text",
                      "letterSpacing": -1.4
                    },
                    {
                      "id": "typeDisplayMeta",
                      "type": "text",
                      "content": "Shippori Mincho  700",
                      "textGrowth": "auto",
                      "fontFamily": "$font.sans",
                      "fontSize": "$font.small",
                      "fontWeight": "400",
                      "fill": "$color.muted",
                      "letterSpacing": 1.2
                    }
                  ]
                },
                {
                  "id": "typeBody",
                  "type": "frame",
                  "name": "typeBody",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "id": "typeBodySample",
                      "type": "text",
                      "content": "暗い場所を消すのではなく、暗い場所が美しくなるように光を置きます。",
                      "textGrowth": "fixed-width",
                      "fontFamily": "$font.serif",
                      "fontSize": "$font.body",
                      "fontWeight": "400",
                      "fill": "$color.text",
                      "lineHeight": 1.75,
                      "width": 360
                    },
                    {
                      "id": "typeBodyMeta",
                      "type": "text",
                      "content": "本文  16",
                      "textGrowth": "auto",
                      "fontFamily": "$font.sans",
                      "fontSize": "$font.small",
                      "fontWeight": "400",
                      "fill": "$color.muted",
                      "letterSpacing": 1.2
                    }
                  ]
                },
                {
