  "children": [
    {
      "id": "page",
      "type": "frame",
      "name": "夜航 UI",
      "x": 0,
      "y": 0,
      "width": 1280,
      "height": "fit_content",
      "layout": "vertical",
      "gap": 36,
      "padding": [
        64,
        56,
        80,
        56
      ],
      "fill": "$color.bg",
      "children": [
        {
          "id": "intro",
          "type": "frame",
          "name": "intro",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 12,
          "children": [
            {
              "id": "introKicker",
              "type": "text",
              "content": "LIGHTING ATELIER · TOKYO",
              "textGrowth": "auto",
              "fontFamily": "$font.sans",
              "fontSize": "$font.kicker",
              "fontWeight": "500",
              "fill": "$color.accent",
              "letterSpacing": 2.6
            },
            {
              "id": "introTitle",
              "type": "text",
              "content": "触れる夜の、部品。",
              "textGrowth": "auto",
              "fontFamily": "$font.serif",
              "fontSize": "$font.display",
              "fontWeight": "700",
              "fill": "$color.text",
              "letterSpacing": -0.6
            },
            {
              "id": "introLede",
              "type": "text",
              "content": "ボタン、調光、手紙の欄。夜航のサイトが次に手で触ることだけを、部品にしています。Pencilのテーマは、地（night / paper）と光（amber / flame / moon）です。",
              "textGrowth": "fixed-width",
              "fontFamily": "$font.serif",
              "fontSize": "$font.body",
              "fontWeight": "400",
              "fill": "$color.muted",
              "lineHeight": 1.75,
              "width": 640
            }
          ]
        },
        {
          "id": "typeBlock",
          "type": "frame",
          "name": "typeBlock",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 20,
          "children": [
            {
              "id": "typeTitle",
              "type": "text",
              "content": "書体",
              "textGrowth": "auto",
              "fontFamily": "$font.serif",
              "fontSize": "$font.h3",
              "fontWeight": "700",
              "fill": "$color.text",
              "letterSpacing": -0.6
            },
            {
              "id": "typeRow",
              "type": "frame",
              "name": "typeRow",
              "width": "fill_container",
              "layout": "horizontal",
              "gap": 48,
              "alignItems": "start",
              "children": [
                {
                  "id": "typeDisplay",
